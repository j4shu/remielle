// W-Engine + drive-disc spec consumed at compile time by tools/edit-save.zig.
//
// The root is `.characters`: a list of per-character blocks. Each block names an
// `.avatar` (a friendly name from the `Avatar` enum in zzz_names.zig), a `.weapon`
// (a friendly name from the `Weapon` enum), and nests that character's 6 slot
// templates under `.slots`. edit-save makes one maxed W-Engine + 6 discs for every
// block, replaces the whole weapon and disc inventories with exactly them, and
// auto-equips each character's W-Engine + 6 discs onto that avatar — so this file is
// the source of truth: a character not listed here ends up with no weapon and empty
// disc slots, and re-running is idempotent (no manual equipping in game). A listed
// character that isn't owned in the save is reported and skipped (its items still
// land in the inventory).
//
// Within a block, each character's 6 slots form a 4-PC + 2-PC build — slots 3-6 are
// pinned to the best-in-slot 4-PC set and slots 1-2 to the recommended 2-PC off-set.
// (Set bonuses are slot-independent, so the split is only bookkeeping; mains/subs are
// derived the same for every slot.) The comments are for humans only — the tool reads
// the fields, not the comment headers.
//
// Per character block (the W-Engine comes first, then the disc slots):
//   .avatar  required. A name from the `Avatar` enum (zzz_names.zig); the block's
//            W-Engine + discs are auto-equipped onto that character.
//   .weapon  required. A name from the `Weapon` enum (zzz_names.zig); one maxed copy
//            (lv60/*5/R5) is made and auto-equipped. The id is comptime-checked
//            against WeaponTemplateTb.
//   .slots   exactly 6 entries, covering slots 1..6 (any order; placed by .slot).
//
// Per slot entry:
//   .slot  1..6
//   .set   required. A set name from the `Set` enum (zzz_names.zig); the disc is made
//          for that one set. Per character: slots 1-2 = 2-PC off-set, slots 3-6 = 4-PC set.
//   .main  optional. Slots 1-3 default to flat HP/ATK/DEF; slots 4-6 require it.
//   .subs  exactly 4, each `.{ <StatEnum>, <upgrades> }`, upgrades summing to 5.
//
// Stat enum (from edit-save.zig):
//   HpFlat AtkFlat DefFlat  HpPct AtkPct DefPct
//   CritRate CritDmg AnomProf  PenFlat
//   main-only (never a sub): PenRatio PhysDmg FireDmg IceDmg ElecDmg EtherDmg
//                            WindDmg EnergyRegen AnomMastery Impact
//
// Rules (enforced as compile errors): a block needs a .weapon present in
// WeaponTemplateTb; a sub may not equal the main; no duplicate subs; a main must be
// legal for that slot; main-only stats can't be subs; the .set must exist in
// EquipmentSuitTemplateTb; each character needs exactly slots 1..6.
//
// Each character block is preceded by a comment header carrying the source
// prydwen.gg URL it was derived from, e.g.
//   https://www.prydwen.gg/zenless/characters/ye-shunguang
//
// Build derivation rules used below (sourced from prydwen.gg):
//   - Weapon (.weapon): the #1 / first-listed entry of the "Best W-Engines" section
//     (the 100.00% baseline pick; name is the text before its "(S n)" refinement marker).
//   - Sets (.set): slots 3-6 use the "Best Disk Drives Sets" #1 4-PC set; slots 1-2 use
//     the top "Best combined with your choice of 2-PC Set" pick (the first "(Recommended)"
//     bullet — or the first bullet if none is marked).
//   - Main (slots 4-6): the first-listed "Best Disk Drives Stats" option.
//   - Subs: the character's substat priority line, with the slot's main and any
//     main-only stat removed, top 4 by listed order.
//   - Upgrades: the user picks a weight split across the 4 subs in priority order
//     (4 non-negative counts summing to 5, applied positionally per slot) — e.g.
//     +3/+2/0/0 or +5/0/0/0. Existing blocks may use any valid split.
//   - Shortfall (when <4 subs survive): the user is asked which sub-capable
//     stat(s) fill the gap; each user-picked sub is noted with "[user pick]".
.{
    .characters = .{
        // ── Ye Shunguang ── W-Engine Cloudcleave Radiance | 4-PC White Water Ballad (slots 3-6) + 2-PC Branch & Blade Song (slots 1-2) ──
        // https://www.prydwen.gg/zenless/characters/ye-shunguang
        // prydwen: D4 ATK% > CRIT DMG% | D5 PEN Ratio% = ATK% | D6 ATK%
        // subs: CRIT DMG = CRIT Rate > ATK% > PEN > ATK
        .{ .avatar = .YeShunguang, .weapon = .CloudcleaveRadiance, .slots = .{
            .{ .slot = 1, .set = .BranchBladeSong, .subs = .{ .{ .CritDmg, 4 }, .{ .CritRate, 1 }, .{ .AtkPct, 0 }, .{ .PenFlat, 0 } } },
            .{ .slot = 2, .set = .BranchBladeSong, .subs = .{ .{ .CritDmg, 4 }, .{ .CritRate, 1 }, .{ .AtkPct, 0 }, .{ .PenFlat, 0 } } },
            .{ .slot = 3, .set = .WhiteWaterBallad, .subs = .{ .{ .CritDmg, 4 }, .{ .CritRate, 1 }, .{ .AtkPct, 0 }, .{ .PenFlat, 0 } } },
            .{ .slot = 4, .set = .WhiteWaterBallad, .main = .AtkPct, .subs = .{ .{ .CritDmg, 4 }, .{ .CritRate, 1 }, .{ .PenFlat, 0 }, .{ .AtkFlat, 0 } } },
            .{ .slot = 5, .set = .WhiteWaterBallad, .main = .PenRatio, .subs = .{ .{ .CritDmg, 4 }, .{ .CritRate, 1 }, .{ .AtkPct, 0 }, .{ .PenFlat, 0 } } },
            .{ .slot = 6, .set = .WhiteWaterBallad, .main = .AtkPct, .subs = .{ .{ .CritDmg, 4 }, .{ .CritRate, 1 }, .{ .PenFlat, 0 }, .{ .AtkFlat, 0 } } },
        } },

        // ── Sunna (CRIT Build) ── W-Engine Thoughtbop | 4-PC Moonlight Lullaby (slots 3-6) + 2-PC Swing Jazz (slots 1-2) ──
        // https://www.prydwen.gg/zenless/characters/sunna
        // prydwen: D4 ATK% | D5 ATK% | D6 Energy Regen
        // subs: ATK% > ATK (until 3500) > Crit Rate = Crit DMG > Flat PEN
        .{ .avatar = .Sunna, .weapon = .Thoughtbop, .slots = .{
            .{ .slot = 1, .set = .SwingJazz, .subs = .{ .{ .AtkPct, 5 }, .{ .AtkFlat, 0 }, .{ .CritRate, 0 }, .{ .CritDmg, 0 } } },
            .{ .slot = 2, .set = .SwingJazz, .subs = .{ .{ .AtkPct, 5 }, .{ .CritRate, 0 }, .{ .CritDmg, 0 }, .{ .PenFlat, 0 } } },
            .{ .slot = 3, .set = .MoonlightLullaby, .subs = .{ .{ .AtkPct, 5 }, .{ .AtkFlat, 0 }, .{ .CritRate, 0 }, .{ .CritDmg, 0 } } },
            .{ .slot = 4, .set = .MoonlightLullaby, .main = .AtkPct, .subs = .{ .{ .AtkFlat, 5 }, .{ .CritRate, 0 }, .{ .CritDmg, 0 }, .{ .PenFlat, 0 } } },
            .{ .slot = 5, .set = .MoonlightLullaby, .main = .AtkPct, .subs = .{ .{ .AtkFlat, 5 }, .{ .CritRate, 0 }, .{ .CritDmg, 0 }, .{ .PenFlat, 0 } } },
            .{ .slot = 6, .set = .MoonlightLullaby, .main = .EnergyRegen, .subs = .{ .{ .AtkPct, 5 }, .{ .AtkFlat, 0 }, .{ .CritRate, 0 }, .{ .CritDmg, 0 } } },
        } },

        // ── Miyabi ── W-Engine Hailstorm Shrine | 4-PC Branch & Blade Song (slots 3-6) + 2-PC Polar Metal (slots 1-2) ──
        // https://www.prydwen.gg/zenless/characters/miyabi
        // prydwen: D4 CRIT Rate% >= ATK% | D5 Ice DMG% = ATK% | D6 ATK%
        // subs: CRIT RATE (Until 80%) >= CRIT DMG = ATK% > Anomaly Proficiency = ATK = PEN
        .{ .avatar = .Miyabi, .weapon = .HailstormShrine, .slots = .{
            .{ .slot = 1, .set = .PolarMetal, .subs = .{ .{ .CritRate, 3 }, .{ .CritDmg, 2 }, .{ .AtkPct, 0 }, .{ .AnomProf, 0 } } },
            .{ .slot = 2, .set = .PolarMetal, .subs = .{ .{ .CritRate, 3 }, .{ .CritDmg, 2 }, .{ .AtkPct, 0 }, .{ .AnomProf, 0 } } },
            .{ .slot = 3, .set = .BranchBladeSong, .subs = .{ .{ .CritRate, 3 }, .{ .CritDmg, 2 }, .{ .AtkPct, 0 }, .{ .AnomProf, 0 } } },
            .{ .slot = 4, .set = .BranchBladeSong, .main = .CritRate, .subs = .{ .{ .CritDmg, 3 }, .{ .AtkPct, 2 }, .{ .AnomProf, 0 }, .{ .AtkFlat, 0 } } },
            .{ .slot = 5, .set = .BranchBladeSong, .main = .IceDmg, .subs = .{ .{ .CritRate, 3 }, .{ .CritDmg, 2 }, .{ .AtkPct, 0 }, .{ .AnomProf, 0 } } },
            .{ .slot = 6, .set = .BranchBladeSong, .main = .AtkPct, .subs = .{ .{ .CritRate, 3 }, .{ .CritDmg, 2 }, .{ .AnomProf, 0 }, .{ .AtkFlat, 0 } } },
        } },
    },
}
